{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/kenken-collection-manifest-v3.schema.json",
  "title": "KenKen collection manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "volume",
    "collection_pdf",
    "generation",
    "page_geometry_points",
    "pages",
    "cross_volume",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "kenken.collection-manifest/v3"},
    "volume": {"type": "integer", "minimum": 1},
    "collection_pdf": {"$ref": "#/$defs/ownedPath"},
    "generation": {"$ref": "#/$defs/generation"},
    "page_geometry_points": {"$ref": "#/$defs/pageGeometry"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    },
    "cross_volume": {"$ref": "#/$defs/crossVolume"},
    "artifact_sha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/ownedPath"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "ownedPath": {
      "type": "string",
      "pattern": "^(?:\\.\\./)?[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "puzzleId": {
      "type": "string",
      "pattern": "^kk-[4-6]x[4-6]-[0-9a-f]{16}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_add_target",
        "max_add_terms",
        "max_cage_cells",
        "max_multiply_factors",
        "max_multiply_target"
      ],
      "properties": {
        "max_add_target": {"type": "integer", "minimum": 1},
        "max_add_terms": {"type": "integer", "minimum": 1},
        "max_cage_cells": {"type": "integer", "minimum": 1},
        "max_multiply_factors": {"type": "integer", "minimum": 1},
        "max_multiply_target": {"type": "integer", "minimum": 1}
      }
    },
    "arithmeticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_to_profiles", "limits", "policy"],
      "properties": {
        "applies_to_profiles": {
          "type": "array",
          "prefixItems": [{"const": "easy"}],
          "items": false
        },
        "limits": {"$ref": "#/$defs/limits"},
        "policy": {"const": "arithmetic-cap-v1"}
      }
    },
    "givenPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_by_profile", "policy"],
      "properties": {
        "max_by_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["easy", "hard", "medium"],
          "properties": {
            "easy": {"type": "integer", "minimum": 0},
            "hard": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0}
          }
        },
        "policy": {"const": "given-cap-v1"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arithmetic_cage_policy",
        "given_cage_policy",
        "max_attempts_per_puzzle",
        "max_solver_nodes",
        "seed_namespace"
      ],
      "properties": {
        "arithmetic_cage_policy": {"$ref": "#/$defs/arithmeticPolicy"},
        "given_cage_policy": {"$ref": "#/$defs/givenPolicy"},
        "max_attempts_per_puzzle": {"type": "integer", "minimum": 1},
        "max_solver_nodes": {"type": "integer", "minimum": 1},
        "seed_namespace": {
          "type": "string",
          "pattern": "^[0-9]{8}xx$"
        }
      }
    },
    "pageGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "width"],
      "properties": {
        "height": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "width": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "puzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_attempt",
        "given_cages",
        "ordinal",
        "puzzle_file",
        "puzzle_id",
        "report_file",
        "seed",
        "solution_file"
      ],
      "properties": {
        "accepted_attempt": {"type": "integer", "minimum": 1},
        "given_cages": {"type": "integer", "minimum": 0},
        "ordinal": {"type": "integer", "minimum": 1},
        "puzzle_file": {"$ref": "#/$defs/packagePath"},
        "puzzle_id": {"$ref": "#/$defs/puzzleId"},
        "report_file": {"$ref": "#/$defs/packagePath"},
        "seed": {"$ref": "#/$defs/seed"},
        "solution_file": {"$ref": "#/$defs/packagePath"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "page_pdf",
        "profile",
        "puzzles",
        "size"
      ],
      "properties": {
        "page_number": {"type": "integer", "minimum": 1},
        "page_pdf": {"$ref": "#/$defs/packagePath"},
        "profile": {"enum": ["easy", "medium", "hard"]},
        "puzzles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/puzzle"}
        },
        "size": {"enum": [4, 5, 6]}
      }
    },
    "priorCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "puzzle_count", "volume"],
      "properties": {
        "manifest": {"$ref": "#/$defs/ownedPath"},
        "puzzle_count": {"type": "integer", "minimum": 1},
        "volume": {"type": "integer", "minimum": 1}
      }
    },
    "crossVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_from_priors",
        "prior_collections",
        "prior_puzzle_count"
      ],
      "properties": {
        "distinct_from_priors": {"const": true},
        "prior_collections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/priorCollection"}
        },
        "prior_puzzle_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
